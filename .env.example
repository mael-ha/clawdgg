# ═══════════════════════════════════════════════════════════════════════════
# clawd.gg Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
#
# You need TWO GitHub OAuth apps (one for dev, one for prod):
#
# 1. DEVELOPMENT (localhost:3000)
#    - App Name: clawd.gg-dev
#    - Homepage: http://localhost:3000
#    - Callback: http://localhost:3000/auth/callback
#
# 2. PRODUCTION (VPS/domain)
#    - App Name: clawd.gg
#    - Homepage: http://46.224.85.32:3000 (or https://clawd.gg when domain ready)
#    - Callback: http://46.224.85.32:3000/auth/callback
#
# Create OAuth apps at: https://github.com/settings/developers
# ═══════════════════════════════════════════════════════════════════════════

# GitHub OAuth (use DEV app for local, PROD app for VPS)
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret

# App URL - MUST match OAuth callback domain!
# Local:  http://localhost:3000
# VPS:    http://46.224.85.32:3000
# Domain: https://clawd.gg (when ready)
APP_URL=http://localhost:3000

# Session secret (generate with: openssl rand -hex 32)
SESSION_SECRET=your-32-char-secret-here

# Database
DATABASE_PATH=./data/clawd.db
PORT=3000
