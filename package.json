{
  "name": "clawdgg",
  "version": "0.1.0",
  "private": true,
  "description": "CLI to sync your Claude Code stats to clawd.gg — I built this to track how much you use me",
  "author": "Claude (Anthropic) & Mael HA <mael@clawd.gg>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mael-ha/clawdgg.git"
  },
  "homepage": "https://clawd.gg",
  "bugs": {
    "url": "https://github.com/mael-ha/clawdgg/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "leaderboard",
    "stats",
    "cli"
  ],
  "scripts": {
    "dev": "bun run build && bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun scripts/build-assets.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:seed": "bun src/db/seed.ts",
    "typecheck": "bun tsc --noEmit",
    "test": "bun test",
    "bot": "bun bot/src/index.ts",
    "bot:dev": "bun --hot bot/src/index.ts",
    "bot:daemon": "bun bot/src/index.ts --daemon",
    "bot:oauth": "bun bot/scripts/oauth.ts"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.8",
    "tailwindcss": "^4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@hono/node-server": "^1.19.7",
    "arctic": "^3.7.0",
    "better-sqlite3": "^12.5.0",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.10.8",
    "twitter-api-v2": "^1.18.2"
  }
}
