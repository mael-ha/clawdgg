# The image installs its own dependencies and builds its own assets — sending
# the host's copies would both bloat the context and shadow them mid-build.
node_modules
public/build

# Compiled CLI binaries — 60MB+ each, rebuilt by the release workflow, and
# never needed in the image.
dist
cli/dist

.git
.claude
data
*.db
*.db-shm
*.db-wal
.env
.env.*
.DS_Store
